# OpenAI
OPENAI_API_KEY=sk-...

# ── RAG / MongoDB ────────────────────────────────────────────────────
# Set ENABLE_RAG=false to run without MongoDB entirely.
# When false, MONGODB_URI is not required and agents rely solely on GPT-4o.
ENABLE_RAG=true
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cv-optimizer

# Server
PORT=3001
NODE_ENV=development

# Pipeline Config
JUDGE_QUALITY_THRESHOLD=7
MAX_RETRIES=3
RETRY_BASE_DELAY_MS=400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
